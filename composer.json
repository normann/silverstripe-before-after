{
    "name": "normann/silverstripe-before-after",
    "description": "A draggable Before/After image comparison slider for SilverStripe 5, available as a reusable DataObject widget and as an Elemental content block.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "cms",
        "before after",
        "image comparison",
        "image slider",
        "elemental"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Normann Lou",
            "email": "normann@somar.co.nz"
        }
    ],
    "support": {
        "issues": "https://github.com/normann/silverstripe-before-after/issues"
    },
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5.0",
        "silverstripe/admin": "^2.0",
        "silverstripe/assets": "^2.0",
        "silverstripe/versioned": "^2.0",
        "dnadesign/silverstripe-elemental": "^5.0",
        "unclecheese/display-logic": "^3.0",
        "tractorcow/silverstripe-sliderfield": "^4.2",
        "tractorcow/silverstripe-colorpicker": "^4.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/recipe-testing": "^3"
    },
    "autoload": {
        "psr-4": {
            "Normann\\BeforeAfter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Normann\\BeforeAfter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "config": {
        "allow-plugins": {
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true,
            "composer/installers": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
